      "required": true
    },
    "descripcion": {
      "type": "richtext"
    },
    "icono": {
      "type": "string"
    },
    "orden": {
      "type": "integer"
    },
    "activo": {
      "type": "boolean",
      "default": true
    },
    "division": {
      "type": "relation",
      "relation": "manyToOne",
