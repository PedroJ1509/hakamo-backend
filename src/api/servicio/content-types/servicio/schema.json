{
  "kind": "collectionType",
  "collectionName": "servicios",
  "info": {
    "singularName": "servicio",
    "pluralName": "servicios",
    "displayName": "Servicio",
    "description": "Servicios del catálogo de /servicios. Se muestran los activos, por orden"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo"
    },
    "descripcion": {
      "type": "text"
    },
    "detalle": {
      "type": "text"
    },
    "etiquetas": {
      "type": "component",
      "repeatable": true,
      "component": "comun.elemento"
    },
    "imagen": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "icono": {
      "type": "string"
    },
    "orden": {
      "type": "integer"
    },
    "activo": {
      "type": "boolean",
      "default": true
    },
    "division": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::division.division",
      "inversedBy": "servicios"
    }
  }
}
