{
  "kind": "collectionType",
  "collectionName": "vacantes",
  "info": {
    "singularName": "vacante",
    "pluralName": "vacantes",
    "displayName": "Vacante",
    "description": "Puestos del portal de empleo. «División» es el área (Construcción, Energía…)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo"
    },
    "descripcion": {
      "type": "blocks"
    },
    "requisitos": {
      "type": "blocks"
    },
    "ubicacion": {
      "type": "string"
    },
    "modalidad": {
      "type": "enumeration",
      "enum": [
        "presencial",
        "remoto",
        "hibrido"
      ]
    },
    "tipo": {
      "type": "enumeration",
      "enum": [
        "tiempo_completo",
        "medio_tiempo",
        "contrato"
      ]
    },
    "salario": {
      "type": "string"
    },
    "estado": {
      "type": "enumeration",
      "default": "activa",
      "enum": [
        "activa",
        "cerrada"
      ]
    },
    "fechaPublicacion": {
      "type": "date"
    },
    "fechaCierre": {
      "type": "date"
    },
    "imagen": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "division": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::division.division",
      "inversedBy": "vacantes"
    },
    "postulacions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::postulacion.postulacion",
      "mappedBy": "vacante"
    }
  }
}
