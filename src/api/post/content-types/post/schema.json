{
  "kind": "collectionType",
  "collectionName": "posts",
  "info": {
    "singularName": "post",
    "pluralName": "posts",
    "displayName": "Post"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo"
    },
    "resumen": {
      "type": "text"
    },
    "contenido": {
      "type": "richtext"
    },
    "imagenPortada": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "fechaPublicacion": {
      "type": "date"
    },
    "activo": {
      "type": "boolean",
      "default": true
    },
    "division": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::division.division",
      "inversedBy": "posts"
    }
  }
}
