{
  "kind": "singleType",
  "collectionName": "configuracion_sitios",
  "info": {
    "singularName": "configuracion-sitio",
    "pluralName": "configuraciones-sitio",
    "displayName": "Configuración del sitio",
    "description": "Logo, contacto, menús, pie y redes. Se ve en todas las páginas"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nombre": {
      "type": "string"
    },
    "nombreLegal": {
      "type": "string"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "logoClaro": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "contacto": {
      "type": "component",
      "repeatable": false,
      "component": "sitio.contacto"
    },
    "redes": {
      "type": "component",
      "repeatable": true,
      "component": "comun.red"
    },
    "menuEmpresas": {
      "type": "component",
      "repeatable": true,
      "component": "comun.boton"
    },
    "botonCabeceraEmpresas": {
      "type": "component",
      "repeatable": false,
      "component": "comun.boton"
    },
    "menuEmpleos": {
      "type": "component",
      "repeatable": true,
      "component": "comun.boton"
    },
    "botonCabeceraEmpleos": {
      "type": "component",
      "repeatable": false,
      "component": "comun.boton"
    },
    "pie": {
      "type": "component",
      "repeatable": false,
      "component": "sitio.pie"
    },
    "mostrarWhatsapp": {
      "type": "boolean",
      "default": true
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "comun.seo"
    }
  }
}
