HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# ───────── Producción (en una máquina de desarrollo no hacen falta) ─────────

# Base de datos. Sin DATABASE_CLIENT se usa SQLite (.tmp/data.db); en el servidor es postgres.
DATABASE_CLIENT=sqlite
# DATABASE_URL=postgres://usuario:clave@localhost:5432/hakamo

# Dirección pública del CMS (detrás de Nginx con HTTPS) e indicador de que va tras un proxy.
# Con IS_PROXIED=true la IP real del visitante se toma de Nginx; el limitador de envíos la necesita.
# PUBLIC_URL=https://cms.hakamo.com.do
# IS_PROXIED=true

# Orígenes que pueden llamar a la API desde un navegador, separados por comas.
# Sin definir se aceptan todos. En el servidor conviene fijarlos:
# CORS_ORIGINS=https://hakamo.com.do,https://www.hakamo.com.do

# Archivos subidos: si estas tres claves faltan, se guardan en public/uploads.
# CLOUDINARY_NAME=
# CLOUDINARY_KEY=
# CLOUDINARY_SECRET=

# Aviso al sitio cuando se guarda contenido (para que lo muestre al instante).
# SITIO_URL es la dirección del sitio web; el secreto debe ser IGUAL a REVALIDAR_SECRETO del frontend.
# SITIO_URL=https://hakamo.com.do
# SITIO_REVALIDAR_SECRETO=

# Solo para pruebas automatizadas locales: apaga el límite de envíos por IP (el tope de tamaño sigue activo).
# No usar en el servidor.
# LIMITE_ENVIOS_DESACTIVADO=true
